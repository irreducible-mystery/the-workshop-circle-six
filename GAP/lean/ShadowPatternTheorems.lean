structure MasterPattern where
  masterEquation : ℝ → ℝ → ℝ  -- G(n) = f(n, parameters)
  parameters : List ℝ  -- Special parameters (perhaps the shadows themselves!)
  domain : ℕ → Bool
  verification : ∀ n, domain n → 
    masterEquation (n : ℝ) parameters ∈ all_shadows

